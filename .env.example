# Copy to `.env` (git-ignored). Never commit real values.

# --- Local development (npm run dev, with `podman compose up -d db`) ---
DATABASE_URL=mysql://hearth:hearth@127.0.0.1:3306/hearth
# Optional: root URL (no database) used by DB integration tests and e2e; they create throwaway
# hearth_test_* / hearth_e2e databases and never touch `hearth`.
# TEST_DATABASE_ADMIN_URL=mysql://root:root@127.0.0.1:3306

# --- AI categorisation (optional; off when AI_BASE_URL is unset) ---
# OpenAI-compatible chat-completions service on your network (POST <base>/v1/chat/completions).
# AI_BASE_URL=https://ai.example.lan
# AI_MODEL=haiku
# Only if the service requires it (sent as `Authorization: Bearer ...`).
# AI_API_KEY=
# AI_TIMEOUT_MS=30000
# Answers below this confidence (0-1) are ignored.
# AI_MIN_CONFIDENCE=0.6

# --- Production stack (compose.prod.yaml) ---
# Image to run. Placeholder: replace OWNER/REPO with your GitHub path (or pin a version tag).
# HEARTH_IMAGE=ghcr.io/OWNER/REPO:latest
# Use long random values, e.g. `openssl rand -hex 24` (hex keeps the password URL-safe). Required; compose refuses to start without them.
# MYSQL_ROOT_PASSWORD=change-me-long-random
# MYSQL_PASSWORD=change-me-long-random
# Host port published on the LAN (the database is never published).
# HEARTH_PORT=3000
# Max upload size for statement files (adapter-node default is only 512K).
# BODY_SIZE_LIMIT=25M
